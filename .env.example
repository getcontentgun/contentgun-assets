# The keys of the one tenant 'default', comma-separated, in plain text. Generate one with:
# openssl rand -hex 32
# Empty, and without TENANTS_FILE and INTERNAL_KEY, every authenticated route answers 500.
API_KEYS=

# Several tenants instead: a TOML file with their key hashes and settings, see tenants.example.toml
# and docs/tenants/README.md. API_KEYS must be empty then. A relative path counts from the
# repository root.
# TENANTS_FILE=tenants.toml

# The folder with one subfolder per tenant that holds its own bundles: <BUNDLES_DIR>/<tenant>/<bundle>/.
# Empty means no bundles beyond the built-in ones in bundles/. A relative path counts from the
# repository root.
# BUNDLES_DIR=/path/to/tenant-bundles

# The key of a service that acts for every tenant and names it in the header X-Contentgun-Tenant.
# At least 32 characters; empty switches it off.
# INTERNAL_KEY=

# Mounts GET /v1/debug/html plus /docs and /openapi.json, all unauthenticated.
# Local development only; keep the service bound to 127.0.0.1 while this is on.
DEBUG_ROUTES=true

STRICT_FONTS=true
RENDER_CONCURRENCY=2
RENDER_TIMEOUT_MS=15000
QUEUE_TIMEOUT_MS=10000

# Largest background image a render request may carry, after base64 decoding.
MAX_IMAGE_BYTES=8388608

# The template id a request without template gets, for every tenant without a default_template
# of its own.
DEFAULT_TEMPLATE=demo/card

# Storage for results as URLs, uploads and the bundles of the tenants: all six or none. Without
# them results come back as files and uploads are off. These values fit the RustFS of
# docker compose -f compose.dev.yaml --profile storage up -d storage, with the service on the host;
# docs/storage/README.md has the details.
# S3_ENDPOINT=http://127.0.0.1:9010
# S3_REGION=us-east-1
# S3_BUCKET=contentgun
# S3_ACCESS_KEY=contentgun
# S3_SECRET_KEY=contentgun-dev-secret
# PUBLIC_FILES_URL=http://127.0.0.1:8010

# The ports of the host that compose publishes RustFS and its console on, where 9010 or 9011 are
# taken. Only compose reads them; S3_ENDPOINT above then names the new STORAGE_PORT.
# STORAGE_PORT=9010
# STORAGE_CONSOLE_PORT=9011

# With the service in the container as well, compose hands it this endpoint instead.
# S3_ENDPOINT_IN_COMPOSE=http://storage:9000

# How long results and uploads stay available, in hours.
# STORAGE_TTL_HOURS=24
